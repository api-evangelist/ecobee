                  "description": "(Required) The application key (API key) for your application."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "Redirect URI (for the authorization_code grant)."
                },
                {
                  "disabled": false,
                  "key": "ecobee_type",
                  "value": "<string>",
                  "description": "Set to `jwt` to have the API return access tokens as JWTs."
                }
