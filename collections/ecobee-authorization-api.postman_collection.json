    {
      "id": "e41d197c-678f-4f2c-b553-a120b39cdc77",
      "name": "Authorization",
      "description": {
        "content": "OAuth 2.0 PIN and authorization-code flows and token refresh.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ac2578db-e8af-4d3a-9f57-ac0dc403b80e",
          "name": "Begin authorization (PIN or authorization code)",
          "request": {
            "name": "Begin authorization (PIN or authorization code)",
            "description": {
              "content": "Starts an authorization flow. For the ecobee PIN flow, set `response_type=ecobeePin`; the response returns a PIN, an authorization `code`, and expiry, which the user enters in the ecobee web portal to grant access. For the authorization-code flow, set `response_type=code` with a `redirect_uri`. This endpoint is on the host root, not under /1.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authorize"
              ],
              "host": [
                "{{authorize-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) `ecobeePin` for the PIN flow, or `code` for the authorization-code flow."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The application key (API key) for your application."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) The requested scope."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "Redirect URI for the authorization-code flow."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Opaque value echoed back for the authorization-code flow."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
